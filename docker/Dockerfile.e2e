FROM php:8.2-apache

RUN apt-get update && apt-get install -y \
    libzip-dev unzip vim less libgd-dev \
    libpng-dev libwebp-dev libjpeg62-turbo-dev sendmail \
    libxpm-dev libfreetype6-dev && \
    docker-php-ext-configure gd --enable-gd --with-webp --with-jpeg --with-xpm --with-freetype && \
    docker-php-ext-install mysqli zip gd && \
    apt-get remove -y libzip-dev libgd-dev \
    libpng-dev libwebp-dev libjpeg62-turbo-dev \
    libxpm-dev libfreetype6-dev && \
    rm -rf /var/lib/apt/lists/* && \
    /usr/sbin/a2enmod rewrite

ADD docker/configs/php*.ini /usr/local/etc/php/conf.d/
ADD https://www.1c-bitrix.ru/download/business_encode.tar.gz /var/www/html/

WORKDIR /var/www/html/

RUN tar xfz business_encode.tar.gz && \
    rm business_encode.tar.gz && \
    mkdir -p /var/www/html/bitrix/php_interface/include/sale_payment/

# Docker Desktop cannot bind-mount the agent's /workspace path. Bake the
# mutable test inputs into this disposable e2e image instead.
COPY docker/configs/.settings.php /var/www/html/bitrix/.settings.php
COPY docker/configs/dbconn.php /var/www/html/bitrix/php_interface/dbconn.php
COPY begateway.erip /var/www/html/bitrix/modules/begateway.erip
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chown -R www-data:www-data /var/www/html && \
    chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
